# ─────────────────────────────────────────────────────────────────────────────
# IITTG data sources
#
# Copy to .env.local for local development. Next.js loads .env.local
# automatically; vitest does NOT, so tests pin mock mode explicitly. Keep the two
# in step or tests stop reflecting production behaviour.
# ─────────────────────────────────────────────────────────────────────────────

# Per-dimension source selection: "live" or "mock".
#
# These three need no credentials, so they default to live and a bare
# `npm run dev` works with no configuration.
IITTG_SOURCE_WEATHER=live
IITTG_SOURCE_HOLIDAYS=live
IITTG_SOURCE_FX=live

# These two need Amadeus credentials. They default to mock, and stay mocked even if
# set to "live" while the credentials below are absent.
IITTG_SOURCE_FLIGHT=mock
IITTG_SOURCE_HOTEL=mock

# ── Amadeus ──────────────────────────────────────────────────────────────────
# Free self-service keys: https://developers.amadeus.com
#
# environment=test     free tier, cached non-bookable data, SPARSE CITY COVERAGE
#                      (most China/Japan/Korea routes return no offers — the
#                      adapter treats that as a normal "no quote", not an error)
# environment=production  billed per call, live availability
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test

# ── Cache ────────────────────────────────────────────────────────────────────
# Disk cache directory. Defaults to ./.cache/iittg
# IITTG_CACHE_DIR=
# Set to 0 to disable disk caching (memory only).
# IITTG_CACHE_DISK=1
