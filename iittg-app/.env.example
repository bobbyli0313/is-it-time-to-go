# ─────────────────────────────────────────────────────────────────────────────
# IITTG data sources
#
# Copy to .env.local for local development. Next.js loads .env.local automatically;
# vitest does NOT, so the test suite pins mock mode explicitly. Keep the two in step
# or the tests stop reflecting production behaviour.
# ─────────────────────────────────────────────────────────────────────────────

# ── Credential-free sources (live by default) ────────────────────────────────
# A bare `npm run dev` works with no configuration at all.
IITTG_SOURCE_WEATHER=live     # Open-Meteo
IITTG_SOURCE_HOLIDAYS=live    # Nager.Date
IITTG_SOURCE_FX=live          # Frankfurter (ECB reference rates)

# ── Flight pricing ───────────────────────────────────────────────────────────
# Amadeus Self-Service was decommissioned on 17 July 2026 and its keys disabled;
# flight access there now requires an enterprise contract. Ignav is the self-serve
# replacement: sign up at https://ignav.com/signup, then set the key below.
# 1,000 free requests, then $2.00 per 1,000 successful requests.
#
# Leave IITTG_SOURCE_FLIGHT=mock until a key is present — an unauthenticated call
# would fail on every request.
IITTG_SOURCE_FLIGHT=mock
IITTG_FLIGHT_PROVIDER=ignav
IITTG_FLIGHT_API_KEY=

# ── Hotel pricing ────────────────────────────────────────────────────────────
# There is no self-serve API for "average nightly rate of central hotels". The OTA
# APIs are partnership-gated and their terms forbid redistributing prices. The index
# is therefore built from price samples this app collects and stores itself:
#   IITTG_HOTEL_SOURCE=self-collected
# and the mock index is used until samples exist for a city.
#
# Collecting the samples is an offline job, never a request-path call, so that the
# product never depends on a live scrape to render a score.
IITTG_HOTEL_SOURCE=mock

# ── Cache ────────────────────────────────────────────────────────────────────
# Disk cache directory. Defaults to ./.cache/iittg
# IITTG_CACHE_DIR=
# Set to 0 to disable disk caching (memory only).
# IITTG_CACHE_DISK=1
