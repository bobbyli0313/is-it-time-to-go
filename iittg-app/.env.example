# ─────────────────────────────────────────────────────────────────────────────
# IITTG data sources
#
# Copy to .env.local for local development. Next.js loads .env.local automatically;
# vitest does NOT, so the test suite pins mock mode explicitly. Keep the two in step
# or the tests stop reflecting production behaviour.
# ─────────────────────────────────────────────────────────────────────────────

# ── Credential-free sources (live by default) ────────────────────────────────
# A bare `npm run dev` works with no configuration at all.
IITTG_SOURCE_WEATHER=live     # Open-Meteo
IITTG_SOURCE_HOLIDAYS=live    # Nager.Date
IITTG_SOURCE_FX=live          # Frankfurter (ECB reference rates)

# ── Flight pricing ───────────────────────────────────────────────────────────
# Amadeus Self-Service was decommissioned on 17 July 2026 and its keys disabled;
# flight access there now requires an enterprise contract. Ignav is the self-serve
# replacement: sign up at https://ignav.com/signup, then set the key below.
# 1,000 free requests, then $2.00 per 1,000 successful requests.
#
# Leave IITTG_SOURCE_FLIGHT=mock until a key is present — an unauthenticated call
# would fail on every request.
IITTG_SOURCE_FLIGHT=mock
IITTG_FLIGHT_PROVIDER=ignav
IITTG_FLIGHT_API_KEY=

# ── Hotel pricing ────────────────────────────────────────────────────────────
# The reference price is the median across the hotels this app has collected itself.
# A single chain's own site cannot answer this — its portfolio is not a city — so
# prices come from Hotelbeds (below), whose one call returns every hotel around a
# point. The collector writes a dataset the app then serves:
#
#   npm run crawl:hotels -- --cities tokyo --census census.csv --import rates.csv
#
# Set the source below to serve that dataset, and point IITTG_HOTEL_DATASET at it if
# you wrote it somewhere other than the default. With `mock`, the synthetic sample
# index is used and the UI says so.
IITTG_HOTEL_SOURCE=mock
# IITTG_HOTEL_DATASET=data/hotel-prices.json

# ── Hotel price collection (Hotelbeds) ───────────────────────────────────────
# The city-wide source: one availability request returns every hotel with
# availability around a city centre, which is the breadth a median needs. Free
# self-serve evaluation key at https://developer.hotelbeds.com (50 requests/day).
# Only the collector CLI reads these; the app never needs them.
IITTG_HOTELBEDS_API_KEY=
IITTG_HOTELBEDS_SECRET=
# test | production. Defaults to test.
IITTG_HOTELBEDS_ENV=test

# ── Cache ────────────────────────────────────────────────────────────────────
# Disk cache directory. Defaults to ./.cache/iittg
# IITTG_CACHE_DIR=
# Set to 0 to disable disk caching (memory only).
# IITTG_CACHE_DISK=1
