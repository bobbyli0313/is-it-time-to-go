# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
next-env.d.ts

# Local npm cache (created because the global ~/.npm cache had root-owned files)
.npm-cache/

# Disk cache for upstream API responses (TTL-managed)
.cache/

# Test and build caches
coverage/
*.tsbuildinfo

# Environment — never commit real keys; .env.example is the tracked template
.env
.env.*
!.env.example

# Local-only planning notes, deliberately not published
PLANS.md
FEASIBILITY.md

# Vercel CLI state. The project link, and — because login here used
# `--global-config` to keep it inside the workspace — the auth token itself. The same
# rule is in iittg-app/.gitignore for when the CLI is run from that directory; this
# entry exists because a root-level `git add -A` is what actually caught it, and GitHub
# push protection is not a thing to rely on as the second line of defence.
.vercel/
.vercel-cli/

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
npm-debug.log*
yarn-error.log*

# npm notifier artefacts, emitted when the cache dir is set to a local path
_logs/
_update-notifier-last-checked
